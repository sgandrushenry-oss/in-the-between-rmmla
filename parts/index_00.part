<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="A scholarly performance for In the Between: Graduate Students, Liminal Spaces, and the Poetics of Becoming, by Samantha Andrus-Henry.">
<title>In the Between — RMMLA Scholarly Performance</title>
<style>
:root{
  --black:#0B0B0B; --white:#FAF9F7; --gray-1:#E8E6E2; --gray-2:#B8B5B0; --gray-3:#77736F;
  --skin-1:#F0D5BE; --skin-2:#D6B99A; --skin-3:#C58C74; --skin-4:#A76D5A; --skin-5:#7C4D4A;
  --paper:#FAF9F7; --ink:#111111; --muted:#66615D; --line:#C9C5BF; --max:1180px;
  --serif: Georgia, 'Times New Roman', serif; --sans: Arial, Helvetica, sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;background:var(--paper);color:var(--ink)}
body{margin:0;background-color:var(--paper);background-image:radial-gradient(circle at 16% 18%, rgba(240,213,190,.18) 0 1px, transparent 2px),radial-gradient(circle at 78% 26%, rgba(214,185,154,.14) 0 1.2px, transparent 2.3px),radial-gradient(circle at 32% 72%, rgba(197,140,116,.10) 0 1.1px, transparent 2.2px),radial-gradient(circle at 84% 80%, rgba(167,109,90,.07) 0 1px, transparent 2px),linear-gradient(180deg, rgba(255,255,255,.38), rgba(255,255,255,.38)),repeating-linear-gradient(0deg, rgba(0,0,0,.012) 0 1px, transparent 1px 6px),repeating-linear-gradient(90deg, rgba(255,255,255,.08) 0 1px, transparent 1px 7px);background-size:260px 260px,320px 320px,380px 380px,460px 460px,100% 100%,7px 7px,9px 9px;background-attachment:fixed;color:var(--ink);font-family:var(--serif);overflow-x:hidden}
a{color:inherit}button,input,textarea,select{font:inherit}
button{cursor:pointer}
button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--skin-3);outline-offset:3px}
.skip{position:absolute;left:-9999px;top:auto}.skip:focus{left:1rem;top:1rem;z-index:999;background:var(--black);color:white;padding:.6rem .8rem}
.topbar{position:fixed;left:0;right:0;top:0;z-index:80;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.75rem 1rem;background:rgba(250,249,247,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.brand{font-family:var(--sans);font-size:.72rem;letter-spacing:.09em;text-transform:uppercase;line-height:1.25;max-width:56ch}.brand em{display:block;text-transform:none;letter-spacing:0;font-family:var(--serif);font-size:.82rem;margin-top:.15rem}
.tools{display:flex;gap:.45rem;flex-wrap:wrap;justify-content:flex-end}.tools button,.tools a{font-family:var(--sans);font-size:.74rem;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--black);background:transparent;color:var(--black);padding:.5rem .65rem;text-decoration:none}.tools button:hover,.tools a:hover{background:var(--black);color:white}
.progress{position:fixed;right:12px;top:50%;transform:translateY(-50%);z-index:70;display:flex;flex-direction:column;gap:8px}.progress a{width:18px;height:18px;display:grid;place-items:center}.progress span{width:7px;height:7px;border:1px solid var(--black);border-radius:50%;display:block;background:var(--paper)}.progress a.active span{background:var(--black);transform:scale(1.25)}
.screen{min-height:100svh;padding:96px 72px 56px;display:grid;place-items:center;position:relative;border-bottom:1px solid var(--gray-1);overflow:hidden}
.screen-inner{width:min(var(--max),100%);position:relative;z-index:2}.eyebrow{font-family:var(--sans);font-size:.76rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gray-3);margin-bottom:1rem}.eyebrow .tone{display:inline-block;width:1.1em;height:1.1em;vertical-align:-.15em;margin-right:.5em;border-radius:50%;background:var(--skin-3)}
h1,h2{font-weight:400;letter-spacing:-.035em;line-height:.98;margin:.15rem 0 1.5rem}h1{font-size:clamp(3rem,8vw,8rem)}h2{font-size:clamp(2.4rem,6vw,6.2rem)}h3{font-family:var(--sans);text-transform:uppercase;letter-spacing:.12em;font-size:.8rem;margin:2rem 0 .75rem}p{font-size:clamp(1.02rem,1.65vw,1.28rem);line-height:1.58;max-width:850px}.lede{font-size:clamp(1.2rem,2.2vw,1.7rem);max-width:900px}.small{font-family:var(--sans);font-size:.82rem;color:var(--muted);line-height:1.45}.citation{font-family:var(--sans);font-size:.8rem;color:var(--muted);letter-spacing:.01em}.statement{font-size:clamp(1.35rem,2.8vw,2.25rem);line-height:1.35;max-width:1000px}.bigline{font-size:clamp(2rem,5vw,5rem);line-height:1.05;max-width:1100px}.nowrap{white-space:nowrap}
.palette-rule{height:8px;width:min(640px,80vw);display:grid;grid-template-columns:repeat(5,1fr);margin:1.8rem 0}.palette-rule span:nth-child(1){background:var(--skin-1)}.palette-rule span:nth-child(2){background:var(--skin-2)}.palette-rule span:nth-child(3){background:var(--skin-3)}.palette-rule span:nth-child(4){background:var(--skin-4)}.palette-rule span:nth-child(5){background:var(--skin-5)}
.entry-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:3rem;align-items:end}.entry-card{border:1px solid var(--line);padding:1.2rem;background:white}.entry-card button{width:100%;border:0;background:var(--black);color:white;padding:.9rem 1rem;font-family:var(--sans);letter-spacing:.06em;text-transform:uppercase}.roomline{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}.roomline code{font-family:ui-monospace,Consolas,monospace;background:var(--gray-1);padding:.25rem .45rem}.live-dot{display:inline-block;width:.7rem;height:.7rem;border-radius:50%;background:var(--gray-2);margin-right:.4rem}.live-dot.on{background:var(--skin-4)}
.route{position:relative;margin:3rem 0 2rem;min-height:220px}.route-line{position:absolute;left:2%;right:2%;top:48%;height:2px;background:var(--black)}.route-stops{position:absolute;inset:0;display:grid;grid-template-columns:repeat(6,1fr);align-items:center}.stop{text-align:center;font-family:var(--sans);font-size:.75rem;letter-spacing:.07em;text-transform:uppercase}.stop::before{content:"";display:block;width:14px;height:14px;background:var(--paper);border:2px solid var(--black);border-radius:50%;margin:0 auto .7rem}.stop:nth-child(1)::before{box-shadow:0 0 0 7px var(--skin-1)}.stop:nth-child(2)::before{box-shadow:0 0 0 7px var(--skin-2)}.stop:nth-child(3)::before{box-shadow:0 0 0 7px var(--skin-3)}.stop:nth-child(4)::before{box-shadow:0 0 0 7px var(--skin-4)}.stop:nth-child(5)::before{box-shadow:0 0 0 7px var(--skin-5)}.stop:nth-child(6)::before{box-shadow:0 0 0 7px var(--gray-2)}
.breakers{position:absolute;inset:0;pointer-events:none}.breaker{position:absolute;max-width:180px;padding:.38rem .55rem;background:white;border:1px solid var(--black);font-family:var(--sans);font-size:.78rem;line-height:1.2;transform:rotate(var(--r,0deg));box-shadow:4px 5px 0 var(--tone,var(--gray-1));transition:.5s}
.threshold-grid{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:.8rem;margin-top:2rem}.threshold{border:1px solid var(--black);padding:1rem;min-height:120px;background:white;display:flex;flex-direction:column;justify-content:space-between}.threshold strong{font-family:var(--sans);font-size:.84rem;letter-spacing:.08em;text-transform:uppercase}.threshold span{font-size:1rem;line-height:1.35}.threshold:nth-child(5n+1){border-top:8px solid var(--skin-1)}.threshold:nth-child(5n+2){border-top:8px solid var(--skin-2)}.threshold:nth-child(5n+3){border-top:8px solid var(--skin-3)}.threshold:nth-child(5n+4){border-top:8px solid var(--skin-4)}.threshold:nth-child(5n+5){border-top:8px solid var(--skin-5)}
.time-stage{height:390px;position:relative;border-left:2px solid var(--black);border-bottom:2px solid var(--black);margin:2rem 0;overflow:hidden;background:linear-gradient(to right,transparent 24.7%,var(--gray-1) 25%,transparent 25.3%,transparent 49.7%,var(--gray-1) 50%,transparent 50.3%,transparent 74.7%,var(--gray-1) 75%,transparent 75.3%)}.time-stage::before{content:"CHRONOS →";position:absolute;left:1rem;top:1rem;font-family:var(--sans);font-size:.72rem;letter-spacing:.12em}.time-stage::after{content:"lived / kairotic / recursive time";position:absolute;left:1rem;bottom:1rem;font-family:var(--serif);font-style:italic;font-size:1.05rem}.time-tick{position:absolute;top:55px;bottom:55px;width:2px;background:var(--black);animation:clockmove 10s linear infinite}.time-fragment{position:absolute;padding:.35rem .55rem;border-radius:999px;background:var(--tone);color:var(--black);font-family:var(--sans);font-size:.78rem;max-width:260px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;animation:drift 8s ease-in-out infinite alternate}.time-fragment.dark{color:white}@keyframes clockmove{from{left:2%}to{left:98%}}@keyframes drift{to{transform:translate(18px,-10px) rotate(2deg)}}
.state-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:2.5rem;align-items:center}.labels{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem}.labelbox{border:2px solid var(--black);padding:1rem;text-align:center;font-family:var(--sans);font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;background:white;position:relative}.labelbox::after{content:"";position:absolute;inset:5px;border:1px solid var(--gray-2);pointer-events:none}.spill{min-height:250px;position:relative;background:transparent;border:0}.spill::before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,rgba(240,213,190,.18),transparent 32%),linear-gradient(315deg,rgba(124,77,74,.14),transparent 24%);pointer-events:none}.spill .breaker{pointer-events:auto}
.daemon-stage{display:grid;grid-template-columns:1fr;gap:1.5rem;align-items:center;max-width:980px}
.conduction{display:grid;grid-template-columns:1fr 100px 1fr;gap:1.3rem;align-items:center;margin-top:2rem}.conduction-box{border:1px solid var(--black);padding:1.2rem;min-height:210px;background:white}.conduction-box h3{margin-top:0}.conduct-arrow{text-align:center;font-size:3rem}.practice-chips{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.2rem}.practice-chips button{border:1px solid var(--black);background:var(--paper);padding:.65rem .8rem;font-family:var(--sans);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}.practice-chips button.active{background:var(--black);color:white} .practice-note{border-left:7px solid var(--skin-3);padding:1rem 1.2rem;background:white;min-height:90px;margin-top:1rem}
.openings-grid{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:.8rem;margin-top:2rem}.opening-card{border:1px solid var(--black);padding:1rem;background:white;min-height:150px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden}.opening-card::before{content:"";position:absolute;left:0;right:0;top:0;height:7px;background:var(--tone,var(--skin-3))}.opening-card strong{font-family:var(--sans);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;margin-top:.55rem}.opening-card span{font-size:.98rem;line-height:1.42}.opening-card .mini-cite{font-family:var(--sans);font-size:.68rem;color:var(--gray-3);margin-top:.8rem}.openings-link{display:inline-block;margin-top:1.2rem;border:1px solid var(--black);background:transparent;padding:.65rem .85rem;font-family:var(--sans);font-size:.75rem;letter-spacing:.08em;text-transform:uppercase}.openings-link:hover{background:var(--black);color:white}
