.practice-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.practice-card{border:1px solid var(--line);background:white;padding:1rem 1.1rem;border-left:8px solid var(--tone,var(--skin-3))}.practice-card h3{margin:.1rem 0 .55rem}.practice-card p{font-size:.98rem;line-height:1.5;margin:.4rem 0}.practice-card .citation{font-size:.72rem}.practice-intro{border-left:8px solid var(--skin-3);padding:1rem 1.2rem;background:white;margin:1rem 0 1.4rem}.practice-intro p{font-size:1rem;margin:.3rem 0}.moderation-list{display:grid;gap:.7rem;margin-top:1rem}.moderation-item{border:1px solid var(--line);padding:.8rem;background:white;display:grid;grid-template-columns:1fr auto;gap:.8rem;align-items:start}.moderation-item.hidden-item{opacity:.5}.moderation-meta{font-family:var(--sans);font-size:.68rem;color:var(--gray-3);margin-top:.25rem}.moderation-item button{border:1px solid var(--black);background:transparent;padding:.4rem .55rem;font-family:var(--sans);font-size:.68rem;text-transform:uppercase;letter-spacing:.06em}.moderation-item button:hover{background:var(--black);color:white}.mod-key{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}.mod-key input{border:1px solid var(--black);padding:.55rem .65rem;min-width:220px}.presenter-panel #open-moderation{display:none}body.presenter .presenter-panel #open-moderation{display:inline-block}.presenter-only-link{display:none!important}body.presenter .presenter-only-link{display:inline-block!important}.mode-view .presenter-panel,.mode-view .presenter-note{display:none!important}.mode-view .presenter-only-link{display:none!important}.mode-view .mode-badge{display:none!important}
.poem-shell{border:1px solid var(--black);min-height:430px;background:white;padding:2rem;position:relative;overflow:hidden}.poem-title{font-family:var(--sans);font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gray-3)}.poem{margin-top:1.4rem}.poem-line{font-size:clamp(1.2rem,2.5vw,2.25rem);line-height:1.25;margin:.55rem 0;display:flex;gap:.7rem;align-items:flex-start;transition:.5s}.poem-line .mark{width:.52em;min-width:.52em;height:1.7em;background:var(--tone);display:inline-block}.poem-empty{color:var(--gray-3);font-style:italic}.poem-controls{display:flex;gap:.55rem;flex-wrap:wrap;margin-top:1rem}.poem-controls button{border:1px solid var(--black);background:transparent;padding:.55rem .7rem;font-family:var(--sans);font-size:.75rem;letter-spacing:.06em;text-transform:uppercase}
.closing{display:grid;grid-template-columns:1fr .7fr;gap:3rem;align-items:center}.unfinished{height:280px;position:relative}.unfinished::before{content:"";position:absolute;left:0;top:50%;width:76%;height:2px;background:var(--black)}.unfinished::after{content:"…";position:absolute;right:5%;top:38%;font-size:6rem;color:var(--skin-4)}
.drawer{position:fixed;inset:0 0 0 auto;width:min(620px,94vw);background:var(--paper);z-index:120;border-left:1px solid var(--black);box-shadow:-20px 0 60px rgba(0,0,0,.14);transform:translateX(102%);transition:.28s;overflow:auto;padding:5rem 2rem 2rem}.drawer.open{transform:none}.drawer-close{position:absolute;right:1rem;top:1rem;border:1px solid var(--black);background:transparent;padding:.45rem .6rem}.drawer h2{font-size:2.6rem;margin-top:0}.def-list{display:grid;gap:1rem}.def{border-top:1px solid var(--line);padding-top:1rem}.def dt{font-family:var(--sans);font-size:.82rem;text-transform:uppercase;letter-spacing:.1em;font-weight:bold}.def dd{margin:.5rem 0 0;font-size:1rem;line-height:1.55}.wc p{font-family:var(--sans);font-size:.91rem;line-height:1.55;padding-left:2rem;text-indent:-2rem;max-width:none}.source-group{margin-top:1.5rem}.source-group h3{font-size:.75rem}.source-group p{font-size:.96rem}
.contribute{position:fixed;left:50%;bottom:1rem;transform:translateX(-50%);z-index:90;background:var(--black);color:white;border:0;padding:.75rem 1rem;font-family:var(--sans);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 5px 20px rgba(0,0,0,.18)}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:200;display:none;place-items:center;padding:1rem}.modal.open{display:grid}.modal-card{width:min(720px,100%);max-height:92vh;overflow:auto;background:var(--paper);border:1px solid var(--black);padding:1.4rem}.modal-card h2{font-size:2.5rem}.prompt-list{display:grid;gap:.85rem}.prompt-btn{display:grid;grid-template-columns:14px 1fr;gap:.75rem;align-items:start;text-align:left;border:1px solid var(--line);background:white;padding:.8rem}.prompt-btn .swatch{width:14px;height:100%;min-height:34px;background:var(--tone)}.prompt-btn.active{border:2px solid var(--black)}textarea{width:100%;min-height:90px;border:1px solid var(--black);background:white;padding:.75rem;resize:vertical}.submit-row{display:flex;justify-content:space-between;gap:1rem;align-items:center;flex-wrap:wrap}.submit-row button{border:1px solid var(--black);background:var(--black);color:white;padding:.7rem .9rem}.submit-row .ghost{background:transparent;color:var(--black)}
.presenter-note{position:fixed;left:1rem;bottom:1rem;z-index:95;background:rgba(11,11,11,.94);color:white;width:min(760px,calc(100vw - 2rem));padding:.75rem 1rem;font-family:var(--sans);font-size:.8rem;line-height:1.4;display:none;border-left:7px solid var(--skin-3)}body.presenter .presenter-note{display:block}.presenter-panel{display:none;position:fixed;right:1rem;bottom:1rem;z-index:96;background:white;border:1px solid var(--black);padding:.6rem;gap:.35rem}body.presenter .presenter-panel{display:flex}.presenter-panel button{font-family:var(--sans);font-size:.7rem;border:1px solid var(--black);background:transparent;padding:.45rem}

.mode-badge{font-family:var(--sans);font-size:.7rem;letter-spacing:.09em;text-transform:uppercase;border:1px solid var(--black);padding:.42rem .58rem;background:white;white-space:nowrap}
.landing{position:fixed;inset:0;z-index:300;background:rgba(250,249,247,.98);display:none;place-items:center;padding:1.5rem}.landing.open{display:grid}.landing-card{width:min(920px,100%);border:1px solid var(--black);background:var(--paper);padding:clamp(1.5rem,4vw,4rem);box-shadow:18px 18px 0 var(--gray-1)}.landing-card h1{font-size:clamp(3rem,7vw,6.5rem);margin-bottom:1rem}.landing-actions{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:2rem}.landing-actions button{min-height:110px;border:1px solid var(--black);background:white;padding:1rem;font-family:var(--sans);font-size:.9rem;letter-spacing:.08em;text-transform:uppercase}.landing-actions button:first-child{background:var(--black);color:white}.landing-note{font-family:var(--sans);font-size:.82rem;color:var(--muted);margin-top:1rem}.qr-reserve{display:none;margin-top:1rem;border:1px dashed var(--gray-2);padding:.8rem;font-family:var(--sans);font-size:.75rem;color:var(--gray-3)}
.cycle-status{font-family:var(--sans);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--gray-3);margin-top:-1rem;margin-bottom:1rem}.time-fragment{white-space:normal;overflow:visible;text-overflow:clip;line-height:1.18;max-width:min(270px,42%);box-shadow:3px 4px 0 rgba(0,0,0,.12);transition:opacity .6s ease,transform .6s ease}.time-fragment.entering{animation:timefade .8s ease both,drift 8s ease-in-out infinite alternate}@keyframes timefade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
body.mode-loop .topbar,body.mode-loop .progress,body.mode-loop .contribute,body.mode-loop .presenter-panel,body.mode-loop .presenter-note{opacity:0;pointer-events:none;transition:opacity 1s ease}body.mode-loop .screen{cursor:none}body.mode-loop .screen-inner{transition:opacity .8s ease}.loop-corner{position:fixed;right:1rem;bottom:1rem;z-index:98;display:none;font-family:var(--sans);font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gray-3)}body.mode-loop .loop-corner{display:block}.loop-corner::before{content:"";display:inline-block;width:.55rem;height:.55rem;border-radius:50%;background:var(--skin-4);margin-right:.45rem;animation:pulse-dot 2s ease-in-out infinite}@keyframes pulse-dot{50%{opacity:.35}}
.poem-page-status{font-family:var(--sans);font-size:.72rem;color:var(--gray-3);margin-top:.8rem}.mode-help{font-family:var(--sans);font-size:.78rem;line-height:1.55;border-left:6px solid var(--skin-3);padding:.85rem 1rem;background:white;margin:1rem 0}
@media(max-width:860px){.screen{padding:92px 28px 64px}.entry-grid,.state-grid,.daemon-stage,.closing{grid-template-columns:1fr}.threshold-grid,.openings-grid{grid-template-columns:repeat(2,1fr)}.practice-cards{grid-template-columns:1fr}.conduction{grid-template-columns:1fr}.conduct-arrow{transform:rotate(90deg)}.progress{display:none}.topbar{align-items:flex-start}.brand{max-width:48vw}.tools{max-width:48vw}.route{min-height:300px}.route-stops{grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,1fr)}.route-line{display:none}}
@media(max-width:540px){.landing-actions{grid-template-columns:1fr}.openings-grid{grid-template-columns:1fr}.landing-card{padding:1.2rem}.time-fragment{max-width:44%;font-size:.7rem}.threshold-grid{grid-template-columns:1fr}.screen{padding-left:20px;padding-right:20px}.brand em{display:none}.tools{max-width:48vw}.route{min-height:300px}}
@media print{.topbar,.progress,.contribute,.presenter-note,.presenter-panel,.modal,.drawer{display:none!important}.screen{min-height:auto;page-break-after:always;padding:1in}.breaker{position:static;display:inline-block;margin:.25rem}.route,.time-stage,.bolt{min-height:250px}}

/* V8: poetic screen language + final talk architecture */
.poem-title{font-size:clamp(2.8rem,7.2vw,7.2rem);line-height:.92;letter-spacing:-.045em;max-width:1050px;margin:.15rem 0 1.4rem}
.poem-title .soft{font-style:italic;color:var(--gray-3)}
.poetic-lines{margin:1.2rem 0 1.8rem;max-width:950px}.poetic-lines p{margin:.12rem 0;font-size:clamp(1.35rem,2.8vw,2.4rem);line-height:1.18}.poetic-lines .indent{padding-left:8vw}.poetic-lines .deep{padding-left:17vw}.poetic-lines .whisper{font-size:clamp(1rem,1.65vw,1.25rem);font-style:italic;color:var(--gray-3)}
.section-label{display:inline-block;font-family:var(--sans);font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;padding:.42rem .6rem;border:1px solid var(--black);margin-bottom:1rem;background:white}
.big-movements{display:flex;flex-wrap:wrap;gap:.55rem;margin:1.25rem 0 1.8rem}.big-movements span{font-family:var(--sans);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--gray-3);padding:.55rem .7rem;background:white}
.turnline{height:1px;background:var(--black);position:relative;margin:2rem 0}.turnline::after{content:'turn';position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);background:var(--paper);padding:0 .8rem;font-family:var(--sans);font-size:.68rem;letter-spacing:.15em;text-transform:uppercase;color:var(--gray-3)}
.little-screen .screen-inner{max-width:1080px}.little-word{font-size:clamp(4rem,13vw,12rem);line-height:.82;letter-spacing:-.065em;margin:0 0 1.2rem;font-weight:400}.little-sub{font-family:var(--sans);letter-spacing:.12em;text-transform:uppercase;font-size:.76rem;color:var(--gray-3);margin-bottom:1.5rem}.little-thesis{font-size:clamp(1.45rem,3.4vw,2.8rem);line-height:1.18;max-width:940px;margin:1rem 0 1.5rem}
