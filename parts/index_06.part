function connectStream(){if(!shared||!window.EventSource)return;stream?.close();stream=new EventSource('/api/stream?room='+encodeURIComponent(room));stream.onmessage=e=>{try{const msg=JSON.parse(e.data);if(msg.type==='snapshot'){contributions=msg.items}else if(msg.type==='add'){if(!contributions.some(x=>x.id===msg.item.id))contributions.push(msg.item)}else if(msg.type==='remove'){contributions=contributions.filter(x=>x.id!==msg.id)}if(!frozen)renderAll()}catch{}};stream.onerror=()=>{status.textContent='Reconnecting shared room…'}}

document.getElementById('submit-fragment').onclick=async()=>{const ta=document.getElementById('fragment');const text=ta.value.trim();if(!text)return;const item={type:selectedPrompt.id,text:text.slice(0,220)};const ss=document.getElementById('submit-status');ss.textContent='Adding…';try{if(shared){const r=await fetch('/api/contributions?room='+encodeURIComponent(room),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(item)});if(!r.ok)throw 0;const saved=await r.json();if(!contributions.some(x=>x.id===saved.id))contributions.push(saved)}else{const saved={...item,id:'local-'+Date.now()+'-'+Math.random().toString(36).slice(2),createdAt:Date.now()};contributions.push(saved);localStorage.setItem(localKey(),JSON.stringify(contributions))}ta.value='';ss.textContent='Submitted for review. Once approved, your words can enter the performance.';renderAll();setTimeout(closeContribute,700)}catch{ss.textContent='Could not add the fragment. Please try again.'}};

const tones=['var(--skin-1)','var(--skin-2)','var(--skin-3)','var(--skin-4)','var(--skin-5)'];
function seeded(n){let x=Math.sin(n*999.91)*43758.5453;return x-Math.floor(x)}
function shuffled(arr,seed){return [...arr].map((v,i)=>({v,k:seeded(seed+i*13.7)})).sort((a,b)=>a.k-b.k).map(x=>x.v)}
function lineFor(c){const p=prompts.find(p=>p.id===c.type)||prompts[0];return (p.lead+' '+c.text).replace(/\s+/g,' ').trim()}
function renderAll(){renderBreakers();renderTime();renderState();renderPoem()}
function sampleOrLive(){if(contributions.length)return contributions;return [
 {type:'between',text:'expert and beginner'}, {type:'interrupted',text:'caregiving'}, {type:'asked',text:'always available'}, {type:'called',text:'the question I could not leave alone'}, {type:'becoming',text:'unfinished'}
]}
function renderBreakers(){const zone=document.querySelector('[data-live-zone="route"]');zone.innerHTML='';const items=sampleOrLive();const start=Math.max(0,items.length-10);items.slice(start).forEach((c,i)=>{const d=document.createElement('div');d.className='breaker';d.textContent=c.text;d.style.setProperty('--tone',tones[(start+i)%tones.length]);d.style.setProperty('--r',(-6+seeded(i+visualSeed)*12)+'deg');const slots=[[4,9],[22,65],[39,13],[55,69],[71,15],[8,57],[29,34],[48,48],[66,39],[80,61]];const slot=slots[i%slots.length];d.style.left=slot[0]+'%';d.style.top=slot[1]+'%';zone.appendChild(d)})}
const TIME_PAGE_SIZE=8; const timeSlots=[[6,72],[52,72],[15,138],[61,138],[6,204],[52,204],[15,270],[61,270]];
function renderTime(){const zone=document.querySelector('[data-live-zone="time"]');zone.innerHTML='';const items=sampleOrLive();const pages=Math.max(1,Math.ceil(items.length/TIME_PAGE_SIZE));timePage=((timePage%pages)+pages)%pages;const start=timePage*TIME_PAGE_SIZE;const batch=items.slice(start,start+TIME_PAGE_SIZE);batch.forEach((c,i)=>{const d=document.createElement('span');d.className='time-fragment entering';const absolute=start+i,ti=absolute%tones.length;d.style.setProperty('--tone',tones[ti]);if(ti===4)d.classList.add('dark');d.textContent=c.text;const slot=timeSlots[i];d.style.left=slot[0]+'%';d.style.top=slot[1]+'px';d.style.animationDelay=(-seeded(absolute+8)*4)+'s';zone.appendChild(d)});const statusEl=document.getElementById('time-cycle-status');if(contributions.length){const end=Math.min(items.length,start+batch.length);statusEl.textContent='cycling through all '+items.length+' contributions · showing '+(start+1)+'–'+end}else{statusEl.textContent='sample fragments · live contributions will cycle through this timeline without stacking'}}
function renderState(){const zone=document.querySelector('[data-live-zone="state"]');zone.innerHTML='';const items=sampleOrLive();const start=Math.max(0,items.length-10);const slots=[[5,7],[42,10],[18,30],[60,30],[5,52],[45,53],[20,73],[62,73],[31,16],[33,62]];items.slice(start).forEach((c,i)=>{const d=document.createElement('div');d.className='breaker';d.textContent=c.text;d.style.setProperty('--tone',tones[(start+i)%tones.length]);d.style.setProperty('--r',(-6+seeded(i+visualSeed)*12)+'deg');d.style.left=slots[i][0]+'%';d.style.top=slots[i][1]+'%';zone.appendChild(d)})}
const POEM_PAGE_SIZE=22;
function renderPoem(){const out=document.getElementById('poem-output'),statusEl=document.getElementById('poem-page-status');if(!contributions.length){out.innerHTML='<p class="poem-empty">Waiting for audience fragments. Sample fragments elsewhere on the site are placeholders; the poem itself remains empty until someone contributes.</p>';statusEl.textContent='';return}const ordered=shuffled(contributions,poemSeed);const pages=Math.max(1,Math.ceil(ordered.length/POEM_PAGE_SIZE));poemPage=((poemPage%pages)+pages)%pages;const start=poemPage*POEM_PAGE_SIZE;const arr=ordered.slice(start,start+POEM_PAGE_SIZE);out.innerHTML='';arr.forEach((c,i)=>{const p=document.createElement('p');p.className='poem-line';p.style.setProperty('--tone',tones[(start+i)%tones.length]);p.innerHTML='<span class="mark" aria-hidden="true"></span><span>'+escapeHtml(lineFor(c))+'</span>';out.appendChild(p)});statusEl.textContent=pages>1?'this arrangement cycles through every contribution · part '+(poemPage+1)+' of '+pages:'all '+contributions.length+' contribution'+(contributions.length===1?'':'s')+' currently visible'}
function escapeHtml(s){return s.replace(/[&<>'"]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[ch]))}
document.getElementById('shuffle-poem').onclick=()=>{poemSeed++;poemPage=0;frozen=false;document.getElementById('freeze-poem').textContent='freeze';renderAll()};
document.getElementById('freeze-poem').onclick=()=>{frozen=!frozen;document.getElementById('freeze-poem').textContent=frozen?'unfreeze':'freeze'};
document.getElementById('export-poem').onclick=()=>{const lines=[...document.querySelectorAll('#poem-output .poem-line span:last-child')].map(x=>x.textContent);const body=['In the Between — provisional audience poem','Room: '+room,'Captured: '+new Date().toLocaleString(),''].concat(lines).join('\n');const blob=new Blob([body],{type:'text/plain'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='in-the-between-'+room+'-'+Date.now()+'.txt';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),500)};

const moderationKey=document.getElementById('moderation-key'), moderationList=document.getElementById('moderation-list'), moderationStatus=document.getElementById('moderation-status');
moderationKey.value=sessionStorage.getItem('inbetween_mod_key')||'';
function openModeration(){openDrawer('moderation');if(moderationKey.value&&shared)loadModeration()}
document.getElementById('open-moderation').onclick=openModeration;
document.getElementById('load-moderation').onclick=loadModeration;
async function loadModeration(){if(!shared){moderationStatus.textContent='Local mode: use the hide buttons below to remove a local fragment from this browser.';renderLocalModeration();return}const key=moderationKey.value.trim();if(!key){moderationStatus.textContent='Enter the moderation key for this presentation.';return}sessionStorage.setItem('inbetween_mod_key',key);moderationStatus.textContent='Loading…';try{const r=await fetch('/api/moderation?room='+encodeURIComponent(room),{headers:{'x-admin-token':key},cache:'no-store'});if(!r.ok)throw new Error('not authorized');const items=await r.json();renderModeration(items);moderationStatus.textContent='Loaded '+items.length+' fragment'+(items.length===1?'':'s')+'. New submissions wait here for approval before they can appear publicly.'}catch{moderationStatus.textContent='Could not load moderation. Check the key and shared server.'}}
function renderModeration(items){moderationList.innerHTML='';if(!items.length){moderationList.innerHTML='<p class="small">No contributions yet.</p>';return}items.slice().reverse().forEach(item=>{const row=document.createElement('div');row.className='moderation-item'+(item.hidden?' hidden-item':'');const left=document.createElement('div');const text=document.createElement('div');text.textContent=lineFor(item);const meta=document.createElement('div');meta.className='moderation-meta';meta.textContent=(item.hidden?(item.pending?'pending · ':'hidden · '):'approved · ')+new Date(item.createdAt).toLocaleTimeString();left.append(text,meta);const b=document.createElement('button');b.textContent=item.hidden?(item.pending?'approve':'restore'):'hide';b.onclick=()=>moderateItem(item.id,!item.hidden);row.append(left,b);moderationList.appendChild(row)})}
async function moderateItem(id,hidden){if(!shared)return;const key=moderationKey.value.trim();try{const r=await fetch('/api/moderate?room='+encodeURIComponent(room),{method:'POST',headers:{'Content-Type':'application/json','x-admin-token':key},body:JSON.stringify({id,hidden,pending:false})});if(!r.ok)throw 0;await loadModeration()}catch{moderationStatus.textContent='Could not change that fragment.'}}
function renderLocalModeration(){const items=contributions.map(x=>({...x,hidden:false}));moderationList.innerHTML='';items.slice().reverse().forEach(item=>{const row=document.createElement('div');row.className='moderation-item';const left=document.createElement('div');const text=document.createElement('div');text.textContent=lineFor(item);left.appendChild(text);const b=document.createElement('button');b.textContent='hide';b.onclick=()=>{contributions=contributions.filter(x=>x.id!==item.id);localStorage.setItem(localKey(),JSON.stringify(contributions));renderAll();renderLocalModeration()};row.append(left,b);moderationList.appendChild(row)});}

const practices={notice:'Notice before immediately judging.',wait:'Remain open while continuing to do the work.',accompany:'Do not make graduate students inhabit uncertainty alone.',mark:'Recognize movement before graduation.',care:'Make intellectual risk materially possible.',allow:'Do not confuse finishing a requirement with finishing a person.'};document.querySelectorAll('[data-practice]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-practice]').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById('practice-note').textContent=practices[b.dataset.practice]});

setInterval(()=>{if(frozen)return;const items=contributions.length?contributions:sampleOrLive();const pages=Math.max(1,Math.ceil(items.length/TIME_PAGE_SIZE));if(pages>1){timePage=(timePage+1)%pages;renderTime()}},7000);
setInterval(()=>{if(frozen||!contributions.length)return;const pages=Math.max(1,Math.ceil(contributions.length/POEM_PAGE_SIZE));if(pages>1){poemPage=(poemPage+1)%pages;if(poemPage===0)poemSeed++;renderPoem()}},14000);
if(legacyPresenter||requestedMode==='present')setMode('present');else if(requestedMode==='loop')setMode('loop');else setMode('explore');
maybeLanding();
detectShared();
</script>
</body>
</html>
